# 2-Minute Sermon — Environment Variables Configuration Template
# Copy this file to '.env' for local development.
# For production, enter these key-value pairs in your hosting dashboard (Vercel / Netlify).

# 🔐 Admin Portal Passphrase
VITE_ADMIN_PASSWORD=Steward2026!

# 🔥 Firebase Firestore Configuration (Optional - for live real-time cloud data sync)
# Create a free project at https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
